rules_version = '2';
// 진행 저장(users)은 본인만 읽고 씀. 에러(errors)는 누구나 쓰기만. 랭킹(scores)은 누구나 읽고, 본인 기록만 '올리는' 쪽으로만 바꿀 수 있음
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'at'])
        && request.resource.data.data is string && request.resource.data.data.size() < 200000
        && request.resource.data.at is number;
    }
    // 플레이어 폰에서 난 에러 (로그인 없이도 쓰기만 됨, 읽기는 콘솔에서만)
    match /errors/{id} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'msg', 'stack', 'ctx', 'ver', 'ua', 'uid', 'at'])
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 20
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 1200
        && request.resource.data.ctx is string && request.resource.data.ctx.size() <= 300
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 160
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
        && request.resource.data.at == request.time;
    }
    // 설문 (별 1~5 + 하고 싶은 말). 로그인 없이도 쓰기만 됨, 읽기는 콘솔에서
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['stars', 'text', 'cleared', 'from', 'ver', 'ua', 'uid', 'at'])
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.cleared is int && request.resource.data.cleared >= 0 && request.resource.data.cleared <= 500
        && request.resource.data.from in ['auto', 'settings']
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 160
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
        && request.resource.data.at == request.time;
    }
    match /scores/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && valid(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid && valid(request.resource.data)
        && request.resource.data.cleared >= resource.data.cleared
        && request.resource.data.tower >= resource.data.tower
        && request.resource.data.contest >= resource.data.contest;
    }
  }
  function valid(d) {
    return d.keys().hasOnly(['name', 'cleared', 'tower', 'contest', 'title', 'fav', 'updated'])
      && d.name is string && d.name.size() > 0 && d.name.size() <= 12
      && d.cleared is int && d.cleared >= 0 && d.cleared <= 500
      && d.tower is int && d.tower >= 0 && d.tower <= 999
      && d.contest is int && d.contest >= 0 && d.contest <= 300000
      // 칭호와 최애 친구 (없어도 됨)
      && (!('title' in d) || (d.title is string && d.title.size() <= 12))
      && (!('fav' in d) || (d.fav is string && d.fav.size() <= 40))
      && d.updated == request.time;
  }
}
